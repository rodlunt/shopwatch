# Copy to .env and edit. Every value here has a working default.

# --- server -----------------------------------------------------------------
SHOPWATCH_PORT=8477
SHOPWATCH_CURRENCY=AUD
# Inside Docker this is set to /data/shopwatch.db by the image; override only for bare metal.
# SHOPWATCH_DB=data/shopwatch.db

# --- decision logic ---------------------------------------------------------
# Ranking penalty applied to a listing whose freight is unresolved, so an unknown-freight
# listing cannot silently outrank a slightly dearer listing with a confirmed delivered
# price. Ranking only: never stored or shown as a price.
SHOPWATCH_UNRESOLVED_FREIGHT_PENALTY=60
# Days before a successfully-fetched field is downgraded to STALE. Manual fields are never
# marked stale.
SHOPWATCH_STALE_AFTER_DAYS=7

# --- scraping manners -------------------------------------------------------
SHOPWATCH_SCRAPING_ENABLED=true
SHOPWATCH_REQUEST_TIMEOUT=20
SHOPWATCH_REQUEST_DELAY=3
# SHOPWATCH_USER_AGENT=

# --- alerting ---------------------------------------------------------------
SHOPWATCH_ALERTS_ENABLED=true
# Full ntfy topic URL, e.g. https://ntfy.example.com/shopwatch
SHOPWATCH_NTFY_URL=
SHOPWATCH_NTFY_TOKEN=
SHOPWATCH_NTFY_PRIORITY=high
SHOPWATCH_WEBHOOK_URL=
