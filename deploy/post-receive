#!/bin/sh
# Deploy hook for /root/shopwatch.git on opti.
#
# Keeps /srv/prod/shopwatch/repo current on every push and rebuilds the
# container only when something that ends up in the image changed. A push that
# only touches README.md or tests/ does not need a rebuild.
[ -d /srv/prod/shopwatch/repo ] && command -v docker >/dev/null 2>&1 || exit 0
unset GIT_DIR

OLD=$(git -C /srv/prod/shopwatch/repo rev-parse HEAD)
git -C /srv/prod/shopwatch/repo pull --ff-only --quiet
NEW=$(git -C /srv/prod/shopwatch/repo rev-parse HEAD)
[ "$OLD" = "$NEW" ] && exit 0

# The compose file is versioned in the repo, so a change to it must land too.
cp /srv/prod/shopwatch/repo/deploy/docker-compose.opti.yml \
   /srv/prod/shopwatch/docker-compose.yml

if git -C /srv/prod/shopwatch/repo diff --name-only "$OLD" "$NEW" \
     | grep -qE '^(app/|Dockerfile|requirements.txt|deploy/docker-compose.opti.yml)'; then
    echo "post-receive: image inputs changed, rebuilding shopwatch"
    cd /srv/prod/shopwatch && docker compose up -d --build --quiet-pull 2>&1 | tail -3
    # Migrations run on boot and are forward-only; an existing database is never wiped.
else
    echo "post-receive: no image inputs changed, container left running"
fi
